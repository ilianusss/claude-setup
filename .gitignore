# This repo is ~/.claude, which is also Claude Code's runtime folder
# (history, projects, sessions, caches, plugins): ignore everything at the
# root, then re-include the setup files.
/*
!/README.md
!/.gitignore
!/.gitattributes
!/.github/
!/CLAUDE.md
!/settings.json
!/skills/
!/agents/
!/mods/
!/docs/

# Skills synced from the claude.ai account
/skills/synced/

# Written by Claude Code beside each mod it loads
/mods/*/.claude-plugin/types/

.DS_Store

# Written by claude plugin eval
/mods/*/evals/results/
