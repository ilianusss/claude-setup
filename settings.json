{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "SKIN_THEME_HOME": "~/.theme",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/workflow:~/.claude/mods/house"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(~/.kube/config)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/.git/claude-workflow/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "skin@ilianusss": true
  },
  "extraKnownMarketplaces": {
    "team": {
      "source": {
        "source": "github",
        "repo": "Zebuilder-ai/zb-claude-config"
      }
    },
    "ilianusss": {
      "source": {
        "source": "github",
        "repo": "ilianusss/claude-skin"
      },
      "autoUpdate": true
    }
  },
  "tui": "fullscreen",
  "theme": "dark-ansi"
}
